# Serves the built web app (Dockerfile). Unlike GitHub Pages, this can send response headers, so the
# page is protected from framing by the browser itself, not only by its own script (ADR-025).
{
	admin off
	auto_https off
	persist_config off
}

# NEAR Intents 1Click, reached by the page on its own origin (ADR-033): no CORS to depend on, and no API key
# anywhere near the browser (none is sent). Only the three read/quote paths the site uses; nothing that submits
# or moves funds. Cookies, auth and the page's origin are stripped on the way out, cookies on the way back.
(oneclick) {
	# For an https upstream Caddy already sends the upstream's own Host.
	reverse_proxy https://1click.chaindefuser.com {
		header_up -Cookie
		header_up -Authorization
		header_up -Origin
		header_up -Referer
		header_down -Set-Cookie
		header_down -Access-Control-Allow-Origin
	}
}

# Railway sets PORT and routes HTTPS to it; TLS ends at Railway's edge.
:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}
	encode zstd gzip

	header {
		# X-Frame-Options, not CSP frame-ancestors: wallet code runs in srcdoc iframes that inherit
		# the page's CSP, and a response header that only covers this document is enough here.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite's hashed file names change with their content, so they can be cached for good.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"

	handle_path /1click/* {
		header Cache-Control "no-store"
		request_body {
			max_size 16KB
		}
		@read {
			method GET
			path /v0/tokens /v0/status
		}
		@quote {
			method POST
			path /v0/quote
		}
		handle @read {
			import oneclick
		}
		handle @quote {
			import oneclick
		}
		handle {
			respond "not a 1Click path this site uses" 404
		}
	}

	file_server

	# Missing paths get the branded page, with the 404 status kept.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
